{
  "rewrites": [
    {
      "source": "/api/vqs/:path*",
      "destination": "/api/vqs/:path*"
    },
    {
      "source": "/vqs-preview",
      "destination": "/vqs-preview.html"
    },
    {
      "source": "/vqs-preview/",
      "destination": "/vqs-preview.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
