{
  "rewrites": [
    {
      "source": "/api/vqs/:path*",
      "destination": "/api/vqs?path=:path*"
    },
    {
      "source": "/api/ops/:path*",
      "destination": "/api/ops?path=:path*"
    },
    {
      "source": "/admin/api/public-publish",
      "destination": "/api/public-publish"
    },
    {
      "source": "/admin/api/public-receipts",
      "destination": "/api/public-receipts"
    },
    {
      "source": "/vqs-preview",
      "destination": "/vqs-preview.html"
    },
    {
      "source": "/vqs-preview/",
      "destination": "/vqs-preview.html"
    },
    {
      "source": "/biblioteca",
      "destination": "/biblioteca/index.html"
    },
    {
      "source": "/biblioteca/",
      "destination": "/biblioteca/index.html"
    },
    {
      "source": "/corporativo/walmart",
      "destination": "/client-quotes/servicios-financieros-ni/index.html"
    },
    {
      "source": "/corporativo/walmart/",
      "destination": "/client-quotes/servicios-financieros-ni/index.html"
    },
    {
      "source": "/corporativo/walmart/:path*",
      "destination": "/client-quotes/servicios-financieros-ni/:path*"
    },
    {
      "source": "/clientes/:slug",
      "destination": "/clientes/index.html"
    },
    {
      "source": "/clientes/:slug/",
      "destination": "/clientes/index.html"
    },
    {
      "source": "/cotizacion/:id",
      "destination": "/cotizacion/index.html"
    },
    {
      "source": "/cotizacion/:id/",
      "destination": "/cotizacion/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
