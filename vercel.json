{
  "rewrites": [
    {
      "source": "/api/vqs/:path*",
      "destination": "/api/vqs?path=:path*"
    },
    {
      "source": "/api/ops/:path*",
      "destination": "/api/ops?path=:path*"
    },
    {
      "source": "/vqs-preview",
      "destination": "/vqs-preview.html"
    },
    {
      "source": "/vqs-preview/",
      "destination": "/vqs-preview.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
