# ELAN AI / ELANKAV CORE - local example.
# Do not commit real values. Configure production values in the platform secrets UI.

# Supabase public client used by the Vite app.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY
VITE_SUPABASE_BUCKET=elanvisual
VITE_EMC_STORAGE_BUCKET=emc-importaciones

# ELANKAV CORE endpoints consumed from the frontend.
VITE_ELANKAV_CORE_URL=http://localhost:3000
VITE_ELANKAV_CORE_ENDPOINT=http://localhost:3000/api/elan-ai
VITE_AI_STUDIO_ENDPOINT=http://localhost:3000/api/elan-ai

# WhatsApp contact shown/used by the frontend.
VITE_WHATSAPP_ELAN=50588888888

# Server-only OpenAI configuration for api/elan-ai.js.
OPENAI_API_KEY=REEMPLAZAR_EN_ENTORNO_LOCAL
OPENAI_MODEL=gpt-4.1-mini

# Server-only WAHA configuration for the real adapter/webhook phase.
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=REEMPLAZAR_EN_ENTORNO_LOCAL
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=REEMPLAZAR_EN_ENTORNO_LOCAL

# Server-only Supabase configuration for adapters/migrations that require service access.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_EN_ENTORNO_LOCAL
