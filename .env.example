# ELAN AI / ELANKAV CORE - plantilla sin secretos reales

# Runtime
NODE_ENV=development
ELAN_AI_ENV=local
ELAN_AI_PRODUCTION_ENABLED=false

# Supabase - cliente Vite
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY
VITE_SUPABASE_BUCKET=elanvisual

# Supabase - servidor/adapters
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# ELANKAV CORE / ELAN AI
VITE_ELANKAV_CORE_URL=http://localhost:3000
VITE_ELANKAV_CORE_AI_ENDPOINT=http://localhost:3000/api/elan-ai
ELANKAV_CORE_URL=http://localhost:3000
ELAN_AI_WEBHOOK_SECRET=TU_WEBHOOK_SECRET

# OpenAI - razonamiento
OPENAI_API_KEY=TU_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# WAHA - transporte WhatsApp
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=TU_WAHA_API_KEY
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=TU_WAHA_WEBHOOK_SECRET

# WhatsApp visible para flujos legacy/frontend
VITE_WHATSAPP_ELAN=50588888888
